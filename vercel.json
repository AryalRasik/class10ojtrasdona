{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "echo 'Static site - no build step required'",
    "outputDirectory": ".",
    "cleanUrls": false,
    "headers": [
        {
            "source": "/sw.js",
            "Cache-Control": "public, max-age=0, must-revalidate"
        },
        {
            "source": "/assets/(.*)",
            "Cache-Control": "public, max-age=31536000, immutable"
        }
    ]
}
