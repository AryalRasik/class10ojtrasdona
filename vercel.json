{
    "builds": [
        {
            "src": "**",
            "use": "@vercel/static"
        }
    ],
    "outputDirectory": ".",
    "rewrites": [
        { "source": "/admin", "destination": "/index.html" },
        { "source": "/librarian", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        }
    ]
}
